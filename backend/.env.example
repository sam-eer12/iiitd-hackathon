APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://tenderlens:tenderlens_dev@127.0.0.1:5432/tenderlens
DATABASE_SCHEMA=tenderlens_api
# AWS runtime: use the RDS hostname and IAM database user without a password.
DATABASE_IAM_AUTH=false
DATABASE_SSL_CA_FILE=
FIREBASE_PROJECT_ID=tenderlens-app-2026
FIREBASE_AUTH_EMULATOR_HOST=
GOOGLE_APPLICATION_CREDENTIALS=
STORAGE_BACKEND=filesystem
LOCAL_STORAGE_PATH=.data/evidence
AWS_REGION=
S3_BUCKET=
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://agent.tinyfish.ai
TINYFISH_MODE=live

# Document verification. Supply credentials through the runtime secret mechanism.
SANDBOX_ENVIRONMENT=test
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
# Required HTTPS profile URL. For localhost demos, see docs/document-verification.md.
SANDBOX_RETURN_URL=
# Required to verify issuer signatures after consent; not required to start OAuth.
DIGILOCKER_SIGNING_CERTIFICATE_PATH=
ENTITYLOCKER_SIGNING_CERTIFICATE_PATH=
CERTIFICATE_VERIFICATION_TTL_HOURS=24
MAX_PROVIDER_CONCURRENCY=1
TINYFISH_MAX_DURATION_SECONDS=300
PROVIDER_OBSERVATION_BUDGET_SECONDS=360
PROVIDER_POLL_INTERVAL_SECONDS=15
SOURCE_CACHE_TTL_SECONDS=600
SOURCE_REFRESH_COOLDOWN_SECONDS=60
MAX_PDF_BYTES=20971520
MAX_PDF_PAGES=150
PDF_PARSE_TIMEOUT_SECONDS=30
JOB_LEASE_SECONDS=90
JOB_HEARTBEAT_SECONDS=20
LOG_LEVEL=INFO
