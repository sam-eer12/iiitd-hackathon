{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "TenderLens containers and CI/CD - preserve Next.js 16 with private CloudFront ingress and EC2 API/worker",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  },
  "Parameters": {
    "Vpc": {
      "Type": "String",
      "MinLength": 1
    },
    "PublicSubnet1": {
      "Type": "String",
      "MinLength": 1
    },
    "PublicSubnet2": {
      "Type": "String",
      "MinLength": 1
    },
    "PrivateSubnet1": {
      "Type": "String",
      "MinLength": 1
    },
    "PrivateSubnet2": {
      "Type": "String",
      "MinLength": 1
    },
    "AppSecurityGroup": {
      "Type": "String",
      "MinLength": 1
    },
    "EvidenceBucket": {
      "Type": "String",
      "MinLength": 1
    },
    "ArtifactBucket": {
      "Type": "String",
      "MinLength": 1
    },
    "IntegrationSecret": {
      "Type": "String",
      "MinLength": 1
    },
    "DataKeyArn": {
      "Type": "String",
      "MinLength": 1
    },
    "DatabaseHost": {
      "Type": "String",
      "MinLength": 1
    },
    "DatabaseResourceId": {
      "Type": "String",
      "MinLength": 1
    },
    "DatabaseSecretArn": {
      "Type": "String",
      "MinLength": 1
    },
    "BackendRepositoryUri": {
      "Type": "String",
      "MinLength": 1
    },
    "FrontendRepositoryUri": {
      "Type": "String",
      "MinLength": 1
    },
    "BackendRepositoryArn": {
      "Type": "String",
      "MinLength": 1
    },
    "FrontendRepositoryArn": {
      "Type": "String",
      "MinLength": 1
    },
    "EnablePublicEdge": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Description": "Enable after AWS approves CloudFront account verification"
    },
    "ConnectionArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:codeconnections:.*:connection/.*"
    },
    "RepositoryId": {
      "Type": "String",
      "Default": "sam-eer12/iiitd-hackathon",
      "AllowedPattern": "[\\w.-]+/[\\w.-]+"
    },
    "Branch": {
      "Type": "String",
      "Default": "main",
      "AllowedPattern": "[\\w./-]+"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t3.small",
      "AllowedValues": [
        "t3.small",
        "t3.medium",
        "t3.large"
      ]
    },
    "ImageId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    "CloudFrontPrefixList": {
      "Type": "String",
      "AllowedPattern": "pl-[a-f0-9]+"
    }
  },
  "Resources": {
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Central encrypted application, worker and build logs",
          "must": []
        }
      },
      "Properties": {
        "RetentionInDays": 30,
        "KmsKeyId": {
          "Ref": "DataKeyArn"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "HostRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Service-specific permissions for this deployment",
          "must": [
            "Scope data access to project resources"
          ]
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "project-access",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability"
                  ],
                  "Resource": [
                    {
                      "Ref": "BackendRepositoryArn"
                    },
                    {
                      "Ref": "FrontendRepositoryArn"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}/bootstrap/current.tar.gz"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${EvidenceBucket}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${EvidenceBucket}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "DatabaseSecretArn"
                    },
                    {
                      "Ref": "IntegrationSecret"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:Decrypt",
                    "kms:GenerateDataKey",
                    "kms:DescribeKey"
                  ],
                  "Resource": {
                    "Ref": "DataKeyArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "rds-db:connect"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:rds-db:${AWS::Region}:${AWS::AccountId}:dbuser:${DatabaseResourceId}/tl_app"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:rds-db:${AWS::Region}:${AWS::AccountId}:dbuser:${DatabaseResourceId}/tl_migrator"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Logs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "HostProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Instance role replaces static AWS keys",
          "must": []
        }
      },
      "Properties": {
        "Roles": [
          {
            "Ref": "HostRole"
          }
        ]
      }
    },
    "AlbSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Internal ALB reachable only through CloudFront VPC origin",
          "must": [
            "No public ALB or public ingress CIDR"
          ]
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "CloudFront origin traffic only",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "SourcePrefixListId": {
              "Ref": "CloudFrontPrefixList"
            }
          }
        ]
      }
    },
    "HostIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Only ALB can reach the reverse proxy",
          "must": []
        }
      },
      "Properties": {
        "GroupId": {
          "Ref": "AppSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 8080,
        "ToPort": 8080,
        "SourceSecurityGroupId": {
          "Ref": "AlbSecurityGroup"
        }
      }
    },
    "Alb": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private origin keeps application hosts off the public request path",
          "must": []
        }
      },
      "Properties": {
        "Type": "application",
        "Scheme": "internal",
        "Subnets": [
          {
            "Ref": "PrivateSubnet1"
          },
          {
            "Ref": "PrivateSubnet2"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "AlbSecurityGroup"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          }
        ]
      }
    },
    "Targets": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Health checks require both the web server and database-backed API",
          "must": []
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Port": 8080,
        "Protocol": "HTTP",
        "TargetType": "instance",
        "HealthCheckPath": "/health/ready",
        "HealthCheckIntervalSeconds": 30,
        "HealthyThresholdCount": 2,
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "HTTP restricted to private VPC-origin transport; viewer traffic uses HTTPS",
          "must": []
        }
      },
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Alb"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "Targets"
            }
          }
        ]
      }
    },
    "LaunchTemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Replaceable SSM-managed Docker host; public IP provides outbound access only",
          "must": [
            "No SSH key or inbound SSH",
            "IMDSv2 required; hop limit 2 for container IAM"
          ]
        }
      },
      "Properties": {
        "LaunchTemplateData": {
          "ImageId": {
            "Ref": "ImageId"
          },
          "InstanceType": {
            "Ref": "InstanceType"
          },
          "IamInstanceProfile": {
            "Arn": {
              "Fn::GetAtt": [
                "HostProfile",
                "Arn"
              ]
            }
          },
          "MetadataOptions": {
            "HttpTokens": "required",
            "HttpPutResponseHopLimit": 2,
            "HttpEndpoint": "enabled"
          },
          "NetworkInterfaces": [
            {
              "DeviceIndex": 0,
              "AssociatePublicIpAddress": true,
              "Groups": [
                {
                  "Ref": "AppSecurityGroup"
                }
              ]
            }
          ],
          "BlockDeviceMappings": [
            {
              "DeviceName": "/dev/xvda",
              "Ebs": {
                "VolumeSize": 30,
                "VolumeType": "gp3",
                "Encrypted": true,
                "KmsKeyId": {
                  "Ref": "DataKeyArn"
                },
                "DeleteOnTermination": true
              }
            }
          ],
          "UserData": {
            "Fn::Base64": {
              "Fn::Sub": "#!/bin/bash\nset -euo pipefail\ndnf install -y docker python3\naws --version\nsystemctl enable --now docker\nmkdir -p /opt/tenderlens /etc/tenderlens\ncat > /etc/tenderlens/runtime.json <<'CONFIG'\n{\"region\":\"${AWS::Region}\",\"databaseHost\":\"${DatabaseHost}\",\"databaseSecret\":\"${DatabaseSecretArn}\",\"integrationSecret\":\"${IntegrationSecret}\",\"evidenceBucket\":\"${EvidenceBucket}\",\"logGroup\":\"${Logs}\",\"backendRepository\":\"${BackendRepositoryUri}\",\"frontendRepository\":\"${FrontendRepositoryUri}\",\"artifactBucket\":\"${ArtifactBucket}\"}\nCONFIG\nchmod 600 /etc/tenderlens/runtime.json\nsystemctl enable --now amazon-ssm-agent\nif aws s3 cp s3://${ArtifactBucket}/bootstrap/current.tar.gz /opt/tenderlens/current.tar.gz --only-show-errors; then\n  mkdir -p /opt/tenderlens/incoming\n  tar -xzf /opt/tenderlens/current.tar.gz -C /opt/tenderlens/incoming\n  cd /opt/tenderlens/incoming\n  bash scripts/deploy.sh\nfi\n"
            }
          }
        }
      }
    },
    "Hosts": {
      "Type": "AWS::AutoScaling::AutoScalingGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "One recoverable host initially; capacity can grow after load testing",
          "must": [
            "Persistent application data lives in RDS/S3, not instance disk"
          ]
        }
      },
      "Properties": {
        "MinSize": "1",
        "MaxSize": "2",
        "DesiredCapacity": "1",
        "VPCZoneIdentifier": [
          {
            "Ref": "PublicSubnet1"
          },
          {
            "Ref": "PublicSubnet2"
          }
        ],
        "LaunchTemplate": {
          "LaunchTemplateId": {
            "Ref": "LaunchTemplate"
          },
          "Version": {
            "Fn::GetAtt": [
              "LaunchTemplate",
              "LatestVersionNumber"
            ]
          }
        },
        "TargetGroupARNs": [
          {
            "Ref": "Targets"
          }
        ],
        "HealthCheckType": "EC2",
        "HealthCheckGracePeriod": 900,
        "Tags": [
          {
            "Key": "Project",
            "Value": "TenderLens",
            "PropagateAtLaunch": true
          },
          {
            "Key": "DeploymentStack",
            "Value": {
              "Ref": "AWS::StackName"
            },
            "PropagateAtLaunch": true
          }
        ]
      }
    },
    "VpcOrigin": {
      "Type": "AWS::CloudFront::VpcOrigin",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private CloudFront-to-ALB connectivity",
          "must": []
        }
      },
      "Properties": {
        "VpcOriginEndpointConfig": {
          "Arn": {
            "Ref": "Alb"
          },
          "Name": {
            "Fn::Sub": "${AWS::StackName}-origin"
          },
          "HTTPPort": 80,
          "HTTPSPort": 443,
          "OriginProtocolPolicy": "http-only",
          "OriginSSLProtocols": [
            "TLSv1.2"
          ]
        }
      },
      "DependsOn": "Listener",
      "Condition": "PublicEdge"
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Managed HTTPS endpoint without requiring a custom domain; Next.js handles caching",
          "must": [
            "Never cache authenticated responses",
            "Forward viewer Host for same-origin checks"
          ]
        }
      },
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "Origins": [
            {
              "Id": "application",
              "DomainName": {
                "Fn::GetAtt": [
                  "Alb",
                  "DNSName"
                ]
              },
              "VpcOriginConfig": {
                "VpcOriginId": {
                  "Fn::GetAtt": [
                    "VpcOrigin",
                    "Id"
                  ]
                },
                "OriginReadTimeout": 120
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "application",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS",
              "PUT",
              "PATCH",
              "POST",
              "DELETE"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "OriginRequestPolicyId": "216adef6-5c7f-47e4-b989-5492eafa07d3"
          },
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          },
          "PriceClass": "PriceClass_200"
        }
      },
      "Condition": "PublicEdge"
    },
    "BuildRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Service-specific permissions for this deployment",
          "must": [
            "Scope data access to project resources"
          ]
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "codebuild.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [],
        "Policies": [
          {
            "PolicyName": "project-access",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetBucketLocation",
                    "s3:GetBucketVersioning"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:Decrypt",
                    "kms:Encrypt",
                    "kms:GenerateDataKey",
                    "kms:DescribeKey"
                  ],
                  "Resource": {
                    "Ref": "DataKeyArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage",
                    "ecr:InitiateLayerUpload",
                    "ecr:UploadLayerPart",
                    "ecr:CompleteLayerUpload",
                    "ecr:PutImage"
                  ],
                  "Resource": [
                    {
                      "Ref": "BackendRepositoryArn"
                    },
                    {
                      "Ref": "FrontendRepositoryArn"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Logs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Build": {
      "Type": "AWS::CodeBuild::Project",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Docker-isolated lint, migrations, tests and image builds with no production secrets",
          "must": [
            "No VPC attachment: build needs registry access",
            "Never pass provider keys as Docker build arguments"
          ]
        }
      },
      "Properties": {
        "ServiceRole": {
          "Fn::GetAtt": [
            "BuildRole",
            "Arn"
          ]
        },
        "Artifacts": {
          "Type": "CODEPIPELINE"
        },
        "Source": {
          "Type": "CODEPIPELINE",
          "BuildSpec": "backend/deploy/buildspec.yml"
        },
        "Environment": {
          "Type": "LINUX_CONTAINER",
          "ComputeType": "BUILD_GENERAL1_SMALL",
          "Image": "aws/codebuild/standard:7.0",
          "PrivilegedMode": true,
          "EnvironmentVariables": [
            {
              "Name": "BACKEND_REPOSITORY",
              "Value": {
                "Ref": "BackendRepositoryUri"
              },
              "Type": "PLAINTEXT"
            },
            {
              "Name": "FRONTEND_REPOSITORY",
              "Value": {
                "Ref": "FrontendRepositoryUri"
              },
              "Type": "PLAINTEXT"
            },
            {
              "Name": "LOG_GROUP",
              "Value": {
                "Ref": "Logs"
              },
              "Type": "PLAINTEXT"
            }
          ]
        },
        "TimeoutInMinutes": 45,
        "LogsConfig": {
          "CloudWatchLogs": {
            "Status": "ENABLED",
            "GroupName": {
              "Ref": "Logs"
            },
            "StreamName": "build"
          }
        }
      }
    },
    "PipelineLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Encrypted EC2 deployment execution logs",
          "must": []
        }
      },
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/codepipeline/${AWS::StackName}-pipeline"
        },
        "KmsKeyId": {
          "Ref": "DataKeyArn"
        },
        "RetentionInDays": 30
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "PipelineRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Service-specific permissions for this deployment",
          "must": [
            "Scope data access to project resources"
          ]
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "codepipeline.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [],
        "Policies": [
          {
            "PolicyName": "project-access",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetBucketVersioning",
                    "s3:GetBucketLocation"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:Decrypt",
                    "kms:Encrypt",
                    "kms:GenerateDataKey",
                    "kms:DescribeKey"
                  ],
                  "Resource": {
                    "Ref": "DataKeyArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "codeconnections:UseConnection",
                    "codestar-connections:UseConnection"
                  ],
                  "Resource": {
                    "Ref": "ConnectionArn"
                  },
                  "Condition": {
                    "StringEqualsIfExists": {
                      "codeconnections:FullRepositoryId": {
                        "Ref": "RepositoryId"
                      },
                      "codeconnections:BranchName": {
                        "Ref": "Branch"
                      },
                      "codeconnections:ProviderPermissionsRequired": "read_only",
                      "codeconnections:ProviderAction": [
                        "GitPull",
                        "GetBranch",
                        "GetCommit",
                        "GetRepository",
                        "StartUploadArchiveToS3",
                        "GetUploadArchiveToS3Status",
                        "GetFile",
                        "GetFolder",
                        "IsRepositoryEmpty",
                        "ListBranches",
                        "ListBranchCommits",
                        "ListCommitFiles",
                        "ListCommitStatuses",
                        "ListRepositories",
                        "ListOwners",
                        "GenerateReferenceLink"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "codeconnections:GetConnection"
                  ],
                  "Resource": {
                    "Ref": "ConnectionArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "codebuild:StartBuild",
                    "codebuild:BatchGetBuilds"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Build",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:DescribeInstances",
                    "elasticloadbalancing:DescribeTargetGroupAttributes",
                    "elasticloadbalancing:DescribeTargetGroups",
                    "elasticloadbalancing:DescribeTargetHealth",
                    "ssm:CancelCommand",
                    "ssm:DescribeInstanceInformation",
                    "ssm:ListCommandInvocations"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "elasticloadbalancing:DeregisterTargets",
                    "elasticloadbalancing:RegisterTargets"
                  ],
                  "Resource": {
                    "Ref": "Targets"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:SendCommand"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/DeploymentStack": {
                        "Ref": "AWS::StackName"
                      }
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:SendCommand"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}::document/AWS-RunShellScript"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "PipelineLogs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Pipeline": {
      "Type": "AWS::CodePipeline::Pipeline",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Every main-branch push runs quality gates before an ordered deployment",
          "must": [
            "QUEUED mode prevents overlapping migrations and releases"
          ]
        }
      },
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-pipeline"
        },
        "RoleArn": {
          "Fn::GetAtt": [
            "PipelineRole",
            "Arn"
          ]
        },
        "PipelineType": "V2",
        "ExecutionMode": "QUEUED",
        "ArtifactStore": {
          "Type": "S3",
          "Location": {
            "Ref": "ArtifactBucket"
          },
          "EncryptionKey": {
            "Type": "KMS",
            "Id": {
              "Ref": "DataKeyArn"
            }
          }
        },
        "Stages": [
          {
            "Name": "Source",
            "Actions": [
              {
                "Name": "GitHub",
                "ActionTypeId": {
                  "Category": "Source",
                  "Owner": "AWS",
                  "Provider": "CodeStarSourceConnection",
                  "Version": "1"
                },
                "Configuration": {
                  "ConnectionArn": {
                    "Ref": "ConnectionArn"
                  },
                  "FullRepositoryId": {
                    "Ref": "RepositoryId"
                  },
                  "BranchName": {
                    "Ref": "Branch"
                  },
                  "DetectChanges": "true",
                  "OutputArtifactFormat": "CODE_ZIP"
                },
                "OutputArtifacts": [
                  {
                    "Name": "Source"
                  }
                ]
              }
            ]
          },
          {
            "Name": "BuildAndTest",
            "Actions": [
              {
                "Name": "Containers",
                "ActionTypeId": {
                  "Category": "Build",
                  "Owner": "AWS",
                  "Provider": "CodeBuild",
                  "Version": "1"
                },
                "Configuration": {
                  "ProjectName": {
                    "Ref": "Build"
                  }
                },
                "InputArtifacts": [
                  {
                    "Name": "Source"
                  }
                ],
                "OutputArtifacts": [
                  {
                    "Name": "Release"
                  }
                ]
              }
            ]
          },
          {
            "Name": "Deploy",
            "Actions": [
              {
                "Name": "EC2",
                "ActionTypeId": {
                  "Category": "Deploy",
                  "Owner": "AWS",
                  "Provider": "EC2",
                  "Version": "1"
                },
                "Configuration": {
                  "InstanceTagKey": "DeploymentStack",
                  "InstanceTagValue": {
                    "Ref": "AWS::StackName"
                  },
                  "InstanceType": "EC2",
                  "TargetDirectory": "/opt/tenderlens/incoming",
                  "PostScript": "scripts/deploy.sh",
                  "TargetGroupNameList": {
                    "Fn::GetAtt": [
                      "Targets",
                      "TargetGroupName"
                    ]
                  },
                  "MaxBatch": "1",
                  "MaxError": "0"
                },
                "InputArtifacts": [
                  {
                    "Name": "Release"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  },
  "Outputs": {
    "WebsiteUrl": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      },
      "Description": "Actual AWS-provisioned HTTPS website URL",
      "Condition": "PublicEdge"
    },
    "PublicEdgeEnabled": {
      "Value": {
        "Ref": "EnablePublicEdge"
      },
      "Description": "Public HTTPS requires CloudFront account verification"
    },
    "PipelineName": {
      "Value": {
        "Ref": "Pipeline"
      },
      "Description": "Pipeline for main-branch deployments"
    },
    "HostRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "HostRole",
          "Arn"
        ]
      },
      "Description": "Runtime IAM role"
    },
    "AutoScalingGroup": {
      "Value": {
        "Ref": "Hosts"
      },
      "Description": "Replaceable application hosts"
    }
  },
  "Conditions": {
    "PublicEdge": {
      "Fn::Equals": [
        {
          "Ref": "EnablePublicEdge"
        },
        "true"
      ]
    }
  }
}
